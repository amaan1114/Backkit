{
  "name": "@ghost1411/backkit",
  "version": "1.0.1",
  "description": "Customizable backend scaffolding CLI for generating production-ready Node.js APIs",
  "keywords": [
    "backend",
    "scaffolding",
    "cli",
    "nodejs",
    "express",
    "typescript",
    "api",
    "generator"
  ],
  "license": "MIT",
  "author": "Amaan Zaidi",
  "type": "module",
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "bin": {
    "backkit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && shx cp -r src/templates dist/templates",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2"
  }
}
